# ═══════════════════════════════════════
# KOBI-EL-System-2026 — Production Env
# ═══════════════════════════════════════
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
JWT_SECRET=minimum-32-character-random-secret-here
AUTH_MODE=production

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=erp@techno-kol.com
SMTP_PASS=your_app_password
FROM_EMAIL="טכנו כל עוזי ERP <erp@techno-kol.com>"

# URLs (production)
VITE_API_URL=https://api.techno-kol.com
ALLOWED_ORIGINS=https://payroll.techno-kol.com,https://ops.techno-kol.com

# Ports
TECHNO_KOL_OPS_PORT=3200
ONYX_PROCUREMENT_PORT=3100
PAYROLL_PORT=5173
ONYX_AI_PORT=3300

# Docker image
IMAGE_PREFIX=ghcr.io/your-org/erp-2026
IMAGE_TAG=latest

# Database (if using local postgres instead of Supabase)
POSTGRES_USER=erp_prod
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=erp_2026
DATABASE_URL=postgresql://erp_prod:change_me_strong_password@postgres:5432/erp_2026

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password
