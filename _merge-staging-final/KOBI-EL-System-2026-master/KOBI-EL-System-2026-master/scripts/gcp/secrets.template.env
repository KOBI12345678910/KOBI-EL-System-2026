# ────────────────────────────────────────────────────────────────────────────
# Techno-Kol Uzi ERP — Secrets template
# ────────────────────────────────────────────────────────────────────────────
# This file is NOT used at runtime. It's a reference of what each secret
# holds and how to populate it from your local shell AFTER deploy.sh has
# created the secret shells with placeholders.
#
# ⚠ NEVER COMMIT A FILLED-IN VERSION OF THIS FILE.  ⚠
#     The committed file has only placeholders.
# ────────────────────────────────────────────────────────────────────────────

# ─── Supabase / Postgres connection string ──────────────────────────────────
# Where to find it:
#   Supabase Dashboard → Project → Settings → Database → Connection string (URI)
#
# How to update (Cloud Shell or local):
#   echo -n 'postgresql://postgres:YOUR_PWD@db.xxxxx.supabase.co:5432/postgres' \
#     | gcloud secrets versions add supabase-db-url --data-file=-
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# ─── Anthropic API key (for onyx-ai LLM features) ───────────────────────────
# Where to find it:
#   https://console.anthropic.com/settings/keys
#
# How to update:
#   echo -n 'sk-ant-api03-...' \
#     | gcloud secrets versions add anthropic-api-key --data-file=-
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME

# ─── Admin API keys (app-level auth) ────────────────────────────────────────
# Generated automatically by deploy.sh on first run (two random hex-64 strings,
# comma-separated). These are also copied into payroll-admin-keys.
#
# To rotate:
#   NEW_KEY=$(openssl rand -hex 32)
#   OLD_KEYS=$(gcloud secrets versions access latest --secret=api-keys)
#   echo -n "${NEW_KEY},${OLD_KEYS}" | gcloud secrets versions add api-keys --data-file=-
#   # ... keep the old one briefly, then drop it after all clients rotated.
API_KEYS=CHANGE_ME,CHANGE_ME
PAYROLL_ADMIN_KEYS=CHANGE_ME,CHANGE_ME

# ─── Payroll employee key map ───────────────────────────────────────────────
# Format: EMP_ID:api_key,EMP_ID:api_key,...
# Each employee-tier token is pinned to exactly one employee_id so the
# denyIfNotOwnerOrAdmin() helper can reject cross-user access.
#
# Generate a key for a new employee:
#   EMP_KEY=$(openssl rand -hex 32)
#   CURRENT=$(gcloud secrets versions access latest --secret=payroll-employee-map)
#   echo -n "${CURRENT},U-123:${EMP_KEY}" | gcloud secrets versions add payroll-employee-map --data-file=-
PAYROLL_EMPLOYEE_KEY_MAP=U-100:CHANGE_ME,U-101:CHANGE_ME

# ─── Cross-service URLs (wired automatically) ───────────────────────────────
# deploy.sh fills these after the services come up, so you should never
# need to set them by hand.
PROCUREMENT_API_URL=https://onyx-procurement-xxxxxxxxxx-ew.a.run.app
ONYX_AI_URL=https://onyx-ai-xxxxxxxxxx-ew.a.run.app
