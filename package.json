{
  "name": "techno-kol-uzi-erp-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Techno-Kol Uzi ERP 2026 — Palantir-grade Enterprise ERP (unified monorepo)",
  "workspaces": [
    "techno-kol-ops",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm --workspace=techno-kol-ops run dev",
    "build": "npm --workspace=techno-kol-ops run build",
    "test": "npm test --workspace=techno-kol-ops --if-present",
    "lint": "npm run lint --workspace=techno-kol-ops --if-present",
    "clean": "npm run clean --workspace=techno-kol-ops --if-present && rimraf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:build": "docker compose build",
    "docker:restart": "docker compose restart",
    "status": "node scripts/status.js",
    "ports": "node scripts/ports.js"
  },
  "dependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "rimraf": "^5.0.10",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^8.2.2",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "local"
  },
  "license": "UNLICENSED",
  "author": "Kobi Elkayam"
}
