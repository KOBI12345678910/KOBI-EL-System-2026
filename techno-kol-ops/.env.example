# B-24: APP_URL required for CORS, email links, receipt URLs
APP_URL=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5174,http://localhost:5173,http://localhost:3100

# ─── Database ───
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.ponypxhushxeskxgrmha.supabase.co:5432/postgres
SUPABASE_URL=https://ponypxhushxeskxgrmha.supabase.co
SUPABASE_ANON_KEY=sb_publishable_0fCmGXqKf70Ld4MuZASGgw_Pz3WTk9J
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY_FROM_SUPABASE_DASHBOARD]
# ─── Auth ───
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# ─── Integration with ONYX ecosystem ───
