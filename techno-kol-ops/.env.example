# ═══════════════════════════════════════════
# TECHNO-KOL OPS — Environment
# Wave 1.5 — 360° compliance hardening
# ═══════════════════════════════════════════

# ─── Server ───
PORT=3200
NODE_ENV=development
# B-24: APP_URL required for CORS, email links, receipt URLs
APP_URL=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5174,http://localhost:5173,http://localhost:3100

# ─── Database ───
DATABASE_URL=postgresql://user:password@localhost:5432/techno_kol

# ─── Auth ───
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# ─── Integration with ONYX ecosystem ───
ONYX_PROCUREMENT_URL=http://localhost:3100
ONYX_AI_URL=http://localhost:3300
ONYX_PROCUREMENT_API_KEY=

# ─── Logging ───
LOG_LEVEL=info
