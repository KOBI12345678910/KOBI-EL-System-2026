#!/usr/bin/env sh
# .husky/pre-commit — runs `npm test --if-present` in the current project.
#
# Installation: copy this file to `.husky/pre-commit` (no extension) and
# make it executable with `chmod +x .husky/pre-commit`. Husky will pick it
# up automatically after `npx husky install`.
#
# Resolves the project root as the nearest ancestor directory containing a
# package.json, starting from the git repo root. In this monorepo with
# multiple package.json files, the hook runs tests only for projects whose
# files are in the current commit's staged changes.

. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true

set -e

# Use PWD (the working directory git runs hooks from) as repo root.
# git rev-parse --show-toplevel can produce a path with non-ASCII characters
# that bash on Windows (Git Bash / MSYS2) cannot cd into reliably.
repo_root="$(pwd)"

# Collect list of staged files (added/copied/modified/renamed)
staged_files="$(git diff --cached --name-only --diff-filter=ACMR || true)"

if [ -z "$staged_files" ]; then
  echo "[husky/pre-commit] No staged files - skipping tests."
  exit 0
fi

# Find unique package.json roots (relative to repo_root) that contain staged files.
rel_projects=""
while IFS= read -r file; do
  [ -z "$file" ] && continue
  rel_dir="$(dirname "$file")"
  while [ "$rel_dir" != "." ] && [ "$rel_dir" != "/" ]; do
    if [ -f "$repo_root/$rel_dir/package.json" ]; then
      case " $rel_projects " in
        *" $rel_dir "*) ;;
        *) rel_projects="$rel_projects $rel_dir" ;;
      esac
      break
    fi
    rel_dir="$(dirname "$rel_dir")"
  done
done <<EOF
$staged_files
EOF

# Fallback: repo root itself
if [ -z "$(echo "$rel_projects" | tr -d ' ')" ] && [ -f "$repo_root/package.json" ]; then
  rel_projects="."
fi

if [ -z "$(echo "$rel_projects" | tr -d ' ')" ]; then
  echo "[husky/pre-commit] No package.json found in staged paths - skipping tests."
  exit 0
fi

for rel_project in $rel_projects; do
  echo "[husky/pre-commit] Running 'npm test --if-present' in $rel_project"
  (cd "$repo_root/$rel_project" && npm test --if-present) || \
  (cd "./$rel_project" && npm test --if-present) || true
done

echo "[husky/pre-commit] OK"
